{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    },
    "_meta": { "title": "입력 이미지" }
  },
  "2": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "v1-5-pruned-emaonly.safetensors"
    },
    "_meta": { "title": "SD1.5 체크포인트" }
  },
  "10": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["2", 0],
      "clip": ["2", 1],
      "lora_name": "example.safetensors",
      "strength_model": 0.8,
      "strength_clip": 1.0
    },
    "_meta": { "title": "화풍 LoRA" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["10", 1],
      "text": "masterpiece, best quality"
    },
    "_meta": { "title": "긍정 프롬프트" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["10", 1],
      "text": "lowres, worst quality, bad anatomy, blurry"
    },
    "_meta": { "title": "부정 프롬프트" }
  },
  "5": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["1", 0],
      "vae": ["2", 2]
    },
    "_meta": { "title": "입력 이미지 인코딩" }
  },
  "7": {
    "class_type": "LineArtPreprocessor",
    "inputs": {
      "image": ["1", 0],
      "coarse": "disable",
      "resolution": 512
    },
    "_meta": { "title": "라인아트 추출" }
  },
  "8": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "control_v11p_sd15_lineart.pth"
    },
    "_meta": { "title": "ControlNet 모델" }
  },
  "9": {
    "class_type": "ControlNetApply",
    "inputs": {
      "conditioning": ["6", 0],
      "control_net": ["8", 0],
      "image": ["7", 0],
      "strength": 0.8
    },
    "_meta": { "title": "구조 고정" }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "positive": ["9", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.6
    },
    "_meta": { "title": "샘플링" }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["2", 2]
    },
    "_meta": { "title": "디코딩" }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "styleforge_apply"
    },
    "_meta": { "title": "결과 저장" }
  }
}
