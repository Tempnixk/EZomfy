# ComfyUI API 서버 주소 (--listen 127.0.0.1 --port 8188 기준)
COMFY_URL=http://127.0.0.1:8188

# 워크플로우 JSON + 매핑 TOML이 위치한 디렉터리
WORKFLOWS_DIR=workflows

# AI 허브 「한국 전통 민화 제작 데이터」 루트 (docs/dataset-aihub-minhwa.md 2장)
# {DATASET_ROOT}\13.한국 전통 민화 제작 데이터\3.개방데이터\1.데이터\ 구조를 기대한다.
DATASET_ROOT=D:\ComfyUI-Easy-Install\ComfyUI-Easy-Install\Data_MinHwa

# 서브셋 선별 결과 · 전처리 결과가 저장되는 디렉터리
DATA_DIR=data

# dataset/caption_auto.py(B경로)가 쓰는 WD14 tagger 모델 (라벨 없는 폴더용)
# 모델은 저장소에 포함하지 않으며, 별도로 받아 경로만 지정한다.
WD14_MODEL_PATH=
WD14_TAGS_CSV=
